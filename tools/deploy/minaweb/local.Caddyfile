# Private CA; only loopback listeners. See the local test section of MINAWEB.md.
# One relay, relay1.minaweb.test; the page fetches its ICE list from there.
# MINAWEB_CSP: the release's Content-Security-Policy, its
# browser/build-info.json's contentSecurityPolicy; unset, the page won't load.
{
    admin off
    local_certs
    skip_install_trust
    default_bind 127.0.0.1
    http_port 4277
    https_port 4278
    servers {
        protocols h1 h2
    }
}
minaweb.test:4274 {
    root * {$RELEASE_DIR}/browser
    header {
        Cross-Origin-Opener-Policy same-origin
        Cross-Origin-Embedder-Policy require-corp
        Cross-Origin-Resource-Policy same-origin
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Content-Security-Policy "{$MINAWEB_CSP:default-src 'none'}"
        X-Frame-Options DENY
        Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()"
        Cache-Control no-cache
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
assets.minaweb.test:4275 {
    @binary path *.postcard *.bin
    header @binary Content-Type application/octet-stream
    header {
        Access-Control-Allow-Origin https://minaweb.test
        Cross-Origin-Resource-Policy cross-origin
        Cache-Control "public, max-age=31536000, immutable"
    }
    handle_path /{$RELEASE_PREFIX}/* {
        root * {$RELEASE_DIR}/upload
        file_server
    }
}
relay1.minaweb.test:4276 {
    @signal path /mina/webrtc/signal /mina/webrtc/signal/*
    handle @signal {
        reverse_proxy 127.0.0.1:4272
    }
    @health path /healthz /readyz
    handle @health {
        reverse_proxy 127.0.0.1:4271
    }
    handle /ice-servers.json {
        # STUN-free loopback test. Production uses the credential service.
        header Content-Type application/json
        header Access-Control-Allow-Origin https://minaweb.test
        header Cross-Origin-Resource-Policy cross-origin
        header Cache-Control no-store
        respond "[]" 200
    }
    handle {
        respond 404
    }
}
