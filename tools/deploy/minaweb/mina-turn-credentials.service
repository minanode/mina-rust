[Unit]
Description=Mina web node expiring TURN credentials
After=network.target

[Service]
Type=exec
DynamicUser=yes
EnvironmentFile=/etc/mina-relay/turn.env
LoadCredential=turn_secret:/etc/mina-relay/turn.secret
ExecStart=/usr/bin/python3 /opt/mina-relay/current/turn-credentials.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
RestrictAddressFamilies=AF_INET AF_UNIX
# It serves nginx on loopback and talks to nothing else.
IPAddressAllow=localhost
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryMax=64M
TasksMax=8

[Install]
WantedBy=multi-user.target
