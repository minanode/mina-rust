[Unit]
Description=Mina web node expiring TURN credentials
After=network.target

[Service]
Type=exec
DynamicUser=yes
EnvironmentFile=/etc/mina-relay/turn.env
LoadCredential=turn_secret:/etc/mina-relay/turn.secret
ExecStart=/usr/bin/python3 /opt/mina-relay/current/turn-credentials.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=64M
TasksMax=8

[Install]
WantedBy=multi-user.target
