# Settings of the relay node, read by mina-relay.service; install as
# /etc/mina-relay/relay.env. No secrets here: the libp2p key is
# /etc/mina-relay/p2p.key. See start-relay.sh for each setting.
NETWORK=devnet
# On 127.0.0.1, closed in the firewall too: the operator API (over SSH) and
# the health checks Caddy proxies.
HTTP_PORT=3000
# The signalling-only listener on 127.0.0.1, which Caddy proxies the
# browsers' signalling to: it has no other route. Caddy's RELAY_SIGNAL_PORT
# must match (default 3001).
WEBRTC_SIGNAL_PORT=3001
MINA_LIBP2P_PORT=8302
MAX_PEERS=100
# The relay has a public address: its host candidates need no STUN server.
ICE_SERVERS_FILE=/etc/mina-relay/ice-servers.json
# Opened for UDP in the firewall. Each WebRTC connection takes a port per
# local address: 1000 ports serve MAX_PEERS=100 with room to spare.
WEBRTC_UDP_PORTS=40000-40999
# Only on a cloud host whose interface has a private address behind a 1:1
# NAT (AWS, GCP): its public IPv4 address.
WEBRTC_NAT_IP=
# The public IPv4 address, so that devnet peers can dial the relay back.
EXTERNAL_IP=<VPS_PUBLIC_IPV4>
EXTRA_ARGS=
