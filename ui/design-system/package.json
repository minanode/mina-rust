{
  "name": "@minanode/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "minanode design system: Tailwind v4 theme tokens and shadcn/ui components, shipped as source",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/globals.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./components/*": "./src/components/*.tsx",
    "./patterns/*": "./src/patterns/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./tokens/*": "./src/tokens/*",
    "./showcase": "./src/showcase/index.tsx",
    "./showcase/sections": "./src/showcase/sections.ts",
    "./fonts/*": "./src/fonts/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
