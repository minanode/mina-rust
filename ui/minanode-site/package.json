{
  "name": "minanode-site",
  "version": "0.1.0",
  "private": true,
  "description": "minanode.org, built as a static export",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 4271",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "serve": "node scripts/serve.mjs out 4270",
    "typecheck": "tsc --noEmit",
    "check:claims": "node scripts/check-claims.mjs",
    "postbuild": "npm run check:content",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run check:claims && npm run test:content && npm run check:content",
    "test:content": "node --test scripts/check-content.test.mjs scripts/check-claims.test.mjs"
  },
  "dependencies": {
    "@minanode/design-system": "0.1.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
